# Protection du dossier API
# Interdire l'accès direct aux fichiers PHP via navigateur
<Files "process.php">
    # On laisse process.php accessible (le formulaire en a besoin)
    # La protection se fait via la validation referer dans le PHP
</Files>

# Désactiver la signature du serveur
ServerSignature Off

# Options de sécurité
Options -Indexes
